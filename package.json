{
  "name": "go-fish",
  "version": "1.0.0",
  "description": "Language-agnostic Go Fish game for language learning",
  "main": "index.js",
  "author": "Cedar Edwards",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "workspaces": [
    "go-fish-engine",
    "go-fish-server",
    "go-fish-ui",
    "go-fish-gameplay-client",
    "go-fish-gameplay-server-plugin",
    "go-fish-csv-plugin"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "start": "node ./go-fish-server/dist/index.js",
    "dev": "turbo start --filter @langfish/go-fish-server",
    "test": "turbo test"
  },
  "packageManager": "pnpm@11.9.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.6.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-plugin-jest": "^29.16.0",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
